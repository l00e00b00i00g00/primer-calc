{
  "name": "@sfstudio_tools/primer-calc",
  "version": "0.2.1",
  "description": "Enterprise & scientific-grade TypeScript library for primer/probe analysis: SantaLucia nearest-neighbor thermodynamics, secondary structures, multiplex cross-dimerization, IUPAC degeneracy.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "wasm/Cargo.toml",
    "wasm/Cargo.lock",
    "wasm/src",
    "wasm-pkg",
    "build-wasm.sh",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && npm run build:worker",
    "build:worker": "esbuild src/multiplex/worker-entry.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=dist/worker.js --log-level=error",
    "build:wasm": "./build-wasm.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "prepublishOnly": "npm run build && npm run build:wasm",
    "example": "tsx examples/quickstart.ts"
  },
  "keywords": [
    "primer",
    "pcr",
    "thermodynamics",
    "santalucia",
    "nearest-neighbor",
    "melting-temperature",
    "bioinformatics",
    "oligonucleotide",
    "multiplex"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.2"
  }
}
